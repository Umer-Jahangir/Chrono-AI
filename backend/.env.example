POSTGRES_USER=chrono
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=chrono
DATABASE_URL=postgresql+psycopg://chrono:replace-with-a-strong-local-password@localhost:5432/chrono
APP_TIMEZONE=Asia/Karachi
N8N_WEBHOOK_SECRET=replace-with-a-long-random-value
FASTAPI_DRIVE_EVENTS_URL=http://host.docker.internal:8000/integrations/google-drive/events
FASTAPI_DRIVE_CONTENT_URL=http://host.docker.internal:8000/integrations/google-drive/content
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_REQUIRE_VERIFIED_EMAIL=true
CHRONO_JWT_SECRET=
CHRONO_JWT_ALGORITHM=HS256
CHRONO_ACCESS_TOKEN_MINUTES=60
ALLOW_LEGACY_DEFAULT_USER=false
CHRONO_N8N_OWNER_USER_ID=your-internal-chrono-user-uuid
FRONTEND_ORIGINS=http://localhost:5173
MAX_INGEST_FILE_BYTES=26214400
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=your-supported-gemini-chat-model
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_EMBEDDING_INPUT_TOKEN_LIMIT=2048
GEMINI_EMBEDDING_BATCH_TOKEN_LIMIT=18000
GEMINI_EMBEDDING_BATCH_SIZE=20
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS=3
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
RAG_TOP_K=8
SEMANTIC_MIN_SIMILARITY=0.35
LEXICAL_MIN_RANK=0.01
